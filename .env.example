# Copy to .env (optional; docker-compose has the same defaults). Demo-only values.
DATABASE_URL=postgresql+psycopg://ps4:ps4@db:5432/ps4
TEST_DATABASE_URL=postgresql+psycopg://ps4:ps4@db:5432/ps4_test
JWT_SECRET=change-me-demo-only

# Prototype login (make seed-users). Demo-only defaults: password = thar1-<username>.
DEMO_PASSWORD_ENGINEER=thar1-engineer
DEMO_PASSWORD_OPERATIONS=thar1-operations
DEMO_PASSWORD_CFO=thar1-cfo
DEMO_PASSWORD_PRESENTER=thar1-presenter
# Passwordless POST /v1/auth/demo-login stays off unless set to true.
DEMO_LOGIN_ENABLED=false
